# ---------------------------------------------------------------------------
# Interswitch Web Checkout (sandbox)
# ---------------------------------------------------------------------------
# Everything below has a working sandbox default, so the payment flow runs
# with NO env file at all. Copy this to `.env.local` only to override.

# TEST = sandbox cashier (https://newwebpay-sandbox.interswitchng.com)
# LIVE = production cashier (https://newwebpay.interswitchng.com)
# The app only goes LIVE when this is EXACTLY "LIVE"; anything else is TEST.
NEXT_PUBLIC_INTERSWITCH_MODE=TEST

# Shared sandbox credentials from the Interswitch quickstart.
# These are NOT secret: they are posted from the browser as part of the
# official Web Redirect flow. Replace with your own from Quickteller Business
# when you generate integration credentials.
NEXT_PUBLIC_INTERSWITCH_MERCHANT_CODE=MX6072
NEXT_PUBLIC_INTERSWITCH_PAY_ITEM_ID=9405967

# Absolute origin of this app, used to build `site_redirect_url`.
# Falls back to the forwarded request host, then http://localhost:3000.
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# Optional — NOT required for Web Redirect
# ---------------------------------------------------------------------------
# The cashier form and the transaction requery are both unauthenticated, so
# this integration does not use them. Kept here because they are part of the
# sandbox credential set and are needed by API-authenticated Interswitch
# products (Card Payment API, Transaction Search, ...).
# INTERSWITCH_CLIENT_ID=IKIAB23A4E2756605C1ABC33CE3C287E27267F660D61
# INTERSWITCH_CLIENT_SECRET=secret

# ---------------------------------------------------------------------------
# Existing app configuration
# ---------------------------------------------------------------------------
# Backend proxy base URL used by RTK Query and the auth thunks.
# NEXT_PUBLIC_BASE_URL=https://api.example.com
